# ─────────────────────────────────────────────────────────────────────────────
# GrossistePPN — Variables d'environnement production
# Copier : cp .env.production.example .env.production
# Remplir les valeurs, puis : chmod 600 .env.production
# NE JAMAIS committer .env.production dans git
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Généré automatiquement par 01_setup_vps.sh, sinon :
# postgresql://ppn_user:MOT_DE_PASSE@localhost:5432/ppn_production
DATABASE_URL=postgresql://ppn_user:CHANGE_MOI@localhost:5432/ppn_production

# ── Better-Auth ───────────────────────────────────────────────────────────────
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_MOI_openssl_rand_base64_32

# URL publique de l'app (sans slash final)
# Avec IP seule  : http://123.456.789.012
# Avec domaine   : https://ppn.mondomaine.mg
BETTER_AUTH_URL=http://TON_IP_VPS

# ── Next.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
